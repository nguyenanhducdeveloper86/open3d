# Optional shared 9router/OpenAI-compatible pool. Leave all three unset to use
# the authenticated Codex, Claude Code, and OpenCode CLIs directly.
OPEN3D_AGENT_POOL_URL=http://127.0.0.1:20128
OPEN3D_AGENT_POOL_TOKEN=replace-with-your-9router-api-key
OPEN3D_AGENT_POOL_MODEL=auto

# Optional direct OpenCode model override when its local default is retired.
# OPEN3D_OPENCODE_MODEL=nvidia/minimaxai/minimax-m3

# Optional high-quality Meshy generation. The viewer never receives these keys.
# MESHY_API_KEY=replace-with-your-meshy-key

# Optional reference-image generation before Meshy Image-to-3D.
# Codex CLI image generation uses the bundled skill CLI and requires OPENAI_API_KEY.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPEN3D_IMAGE_GEN_CLI=/Users/you/.codex/skills/.system/imagegen/scripts/image_gen.py

# Optional local mcp-all2api browser bridge (start it with `npm start` in mcp-all2api).
# No API key is used; the bridge needs a connected ChatGPT/Flow/Grok Chrome worker.
# ALL2API_BASE=http://127.0.0.1:3737
# ALL2API_IMAGE_TOOL=chatgpt

# Optional standalone OpenAI-compatible image gateway instead of the browser bridge.
# ALL2API_BASE_URL=http://127.0.0.1:3000/v1
# ALL2API_API_KEY=replace-with-your-all2api-key
# ALL2API_IMAGE_MODEL=gpt-image-2
