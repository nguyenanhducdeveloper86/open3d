# Optional shared 9router/OpenAI-compatible pool. Leave all three unset to use
# the authenticated Codex, Claude Code, and OpenCode CLIs directly.
OPEN3D_AGENT_POOL_URL=http://127.0.0.1:20128
OPEN3D_AGENT_POOL_TOKEN=replace-with-your-9router-api-key
OPEN3D_AGENT_POOL_MODEL=auto

# Optional direct OpenCode model override when its local default is retired.
# OPEN3D_OPENCODE_MODEL=nvidia/minimaxai/minimax-m3
