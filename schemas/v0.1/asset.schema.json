{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open3d.artist/schemas/v0.1/asset.schema.json",
  "title": "Open3D Asset Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "kind", "units", "dimensions", "parts", "geometry"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "asset_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["prop", "environment", "character", "material", "scene"]},
    "units": {"const": "m"},
    "dimensions": {
      "type": "object", "additionalProperties": false, "required": ["width", "depth", "height"],
      "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "depth": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["part_id"], "properties": {"part_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}, "role": {"type": "string"}, "parent_part_id": {"type": ["string", "null"]}, "mutable": {"type": "boolean"}, "preserve": {"type": "array", "items": {"type": "string"}}}}
    },
    "geometry": {
      "type": "object", "additionalProperties": false, "required": ["triangle_budget"],
      "properties": {
        "triangle_budget": {"type": "object", "additionalProperties": false, "required": ["max"], "properties": {"max": {"type": "integer", "minimum": 1}}},
        "primitives": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["part_id"], "properties": {"part_id": {"type": "string"}, "type": {"enum": ["box", "cylinder"]}, "size": {"type": "object"}, "center": {"type": "object"}, "scale": {"type": "object"}, "color": {"type": ["string", "array"]}, "radius": {"type": "number", "exclusiveMinimum": 0}, "depth": {"type": "number", "exclusiveMinimum": 0}, "segments": {"type": "integer", "minimum": 3}, "axis": {"enum": ["x", "y", "z"]}}}}
      }
    },
    "outputs": {"type": "object"},
    "pivot": {"type": "object"},
    "artstyle": {"type": ["string", "object"]},
    "references": {"type": "array"},
    "metadata": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
